# ── 절대 커밋하면 안 되는 것 (공개 저장소) ─────────────────────────
# 서명 키 / 키스토어
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.der
# 서명 키 비밀번호가 담기는 파일
**/key.properties
# 로컬 SDK 경로 등
**/local.properties
# 환경변수 / 시크릿
.env
.env.*
!.env.example
secrets.json
service-account*.json
# Firebase / GCP 설정 (프로젝트 식별자 및 클라이언트 키 포함)
**/google-services.json
**/GoogleService-Info.plist

# ── Flutter / Dart ────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
coverage/
**/doc/api/
app.*.symbols
app.*.map.json

# ── Android ───────────────────────────────────────────────────────
/android/.gradle/
/android/app/debug/
/android/app/profile/
/android/app/release/
*.class

# ── iOS / macOS ───────────────────────────────────────────────────
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
# flutter pub get이 생성하는 로컬 경로 파일 (머신마다 다름)
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/Flutter/App.framework/
**/Flutter/Flutter.framework/
**/Flutter/Flutter.podspec
**/Pods/
.DS_Store

# ── 에디터 / IDE ──────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.log
.history

# ── 에이전트 도구 작업 공간 ───────────────────────────────────────
# 병렬 작업을 격리하려고 만드는 git worktree 체크아웃 자리다. 저장소
# 내용물이 아니라 로컬 작업 공간이므로 커밋하지 않는다.
# .claude/ 를 통째로 막지 않는 이유는 그 아래 공유용 설정(skills,
# settings.json 등)이 들어갈 수 있고 그건 커밋 대상이기 때문이다.
.claude/worktrees/
